<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>DARK TICKET — اختر سيرفرك</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;900&display=swap" rel="stylesheet" />
  <style>
    :root {
      --bg-primary:   #0b0b12;
      --bg-panel:     rgba(20, 20, 35, 0.75);
      --purple-glow:  #8a2be2;
      --purple-light: #a855f7;
      --purple-dim:   rgba(138, 43, 226, 0.15);
      --border-glass: rgba(138, 43, 226, 0.25);
      --text-primary: #f0e6ff;
      --text-muted:   #8b85a0;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: 'Cairo', sans-serif;
      background-color: var(--bg-primary);
      color: var(--text-primary);
      min-height: 100vh;
    }

    /* خلفية متوهجة */
    .stars-bg {
      position: fixed;
      inset: 0;
      background:
        radial-gradient(ellipse at 15% 25%, rgba(138,43,226,0.10) 0%, transparent 55%),
        radial-gradient(ellipse at 85% 75%, rgba(88,28,135,0.09) 0%, transparent 55%),
        var(--bg-primary);
      z-index: 0;
    }

    /* النافبار */
    .navbar {
      position: fixed;
      top: 0; left: 0; right: 0;
      z-index: 100;
      padding: 0.9rem 2rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      background: rgba(11,11,18,0.90);
      backdrop-filter: blur(20px);
      border-bottom: 1px solid var(--border-glass);
    }

    .navbar-logo {
      font-size: 1.3rem;
      font-weight: 900;
      background: linear-gradient(135deg, #c084fc, #a855f7, #8a2be2);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    /* معلومات المستخدم في النافبار */
    .user-info {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      background: rgba(138,43,226,0.12);
      border: 1px solid var(--border-glass);
      border-radius: 100px;
      padding: 0.4rem 1rem 0.4rem 0.4rem;
    }

    .user-avatar {
      width: 32px;
      height: 32px;
      border-radius: 50%;
      border: 2px solid var(--purple-glow);
      object-fit: cover;
    }

    .user-name {
      font-size: 0.9rem;
      font-weight: 600;
      color: #e2d9f3;
    }

    .btn-logout {
      font-size: 0.8rem;
      color: var(--text-muted);
      text-decoration: none;
      padding: 0.3rem 0.7rem;
      border: 1px solid rgba(138,43,226,0.2);
      border-radius: 0.4rem;
      transition: all 0.2s;
      font-family: 'Cairo', sans-serif;
    }
    .btn-logout:hover {
      background: rgba(138,43,226,0.15);
      color: #c084fc;
      border-color: var(--purple-glow);
    }

    /* بطاقة الزجاج */
    .glass-card {
      background: var(--bg-panel);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border: 1px solid var(--border-glass);
      border-radius: 1.25rem;
      box-shadow:
        0 0 30px rgba(138,43,226,0.07),
        inset 0 1px 0 rgba(255,255,255,0.04);
      transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
    }

    /* بطاقة السيرفر */
    .server-card {
      background: var(--bg-panel);
      backdrop-filter: blur(16px);
      border: 1px solid var(--border-glass);
      border-radius: 1.1rem;
      padding: 1.5rem;
      display: flex;
      align-items: center;
      gap: 1.25rem;
      transition: all 0.3s ease;
      box-shadow: 0 0 20px rgba(138,43,226,0.05);
    }

    .server-card:hover {
      transform: translateY(-3px);
      border-color: var(--purple-glow);
      box-shadow:
        0 0 35px rgba(138,43,226,0.18),
        inset 0 1px 0 rgba(255,255,255,0.06);
    }

    /* أيقونة السيرفر */
    .server-icon {
      width: 60px;
      height: 60px;
      border-radius: 1rem;
      object-fit: cover;
      border: 2px solid var(--border-glass);
      flex-shrink: 0;
      transition: border-color 0.3s;
    }
    .server-card:hover .server-icon {
      border-color: var(--purple-glow);
    }

    /* بديل عند غياب الأيقونة */
    .server-icon-placeholder {
      width: 60px;
      height: 60px;
      border-radius: 1rem;
      background: linear-gradient(135deg, #3b1f6b, #1e1035);
      border: 2px solid var(--border-glass);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.5rem;
      font-weight: 900;
      color: #c084fc;
      flex-shrink: 0;
      transition: border-color 0.3s;
    }
    .server-card:hover .server-icon-placeholder {
      border-color: var(--purple-glow);
    }

    /* زر الإعداد */
    .btn-setup {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      padding: 0.55rem 1.2rem;
      background: linear-gradient(135deg, #6d28d9, #8a2be2);
      color: #fff;
      font-family: 'Cairo', sans-serif;
      font-size: 0.9rem;
      font-weight: 700;
      border: none;
      border-radius: 0.6rem;
      cursor: pointer;
      text-decoration: none;
      transition: all 0.3s ease;
      white-space: nowrap;
      flex-shrink: 0;
      box-shadow: 0 0 15px rgba(138,43,226,0.35);
    }
    .btn-setup:hover {
      transform: scale(1.05);
      box-shadow: 0 0 28px rgba(138,43,226,0.6);
    }

    /* زر إضافة البوت */
    .btn-invite {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.6rem 1.4rem;
      background: transparent;
      color: #a78bfa;
      font-family: 'Cairo', sans-serif;
      font-size: 0.9rem;
      font-weight: 600;
      border: 1px dashed rgba(138,43,226,0.45);
      border-radius: 0.6rem;
      cursor: pointer;
      text-decoration: none;
      transition: all 0.3s ease;
      white-space: nowrap;
      flex-shrink: 0;
    }
    .btn-invite:hover {
      background: rgba(138,43,226,0.12);
      border-color: var(--purple-glow);
      color: #c084fc;
    }

    /* تنسيق النص */
    .text-glow {
      background: linear-gradient(135deg, #c084fc, #a855f7, #8a2be2);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    /* بادج حالة البوت */
    .badge-active {
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
      background: rgba(34,197,94,0.12);
      border: 1px solid rgba(34,197,94,0.3);
      color: #4ade80;
      font-size: 0.75rem;
      font-weight: 600;
      padding: 0.2rem 0.65rem;
      border-radius: 100px;
    }
    .badge-inactive {
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
      background: rgba(139,133,160,0.1);
      border: 1px solid rgba(139,133,160,0.25);
      color: var(--text-muted);
      font-size: 0.75rem;
      font-weight: 600;
      padding: 0.2rem 0.65rem;
      border-radius: 100px;
    }

    /* رسالة الفراغ */
    .empty-state {
      text-align: center;
      padding: 4rem 2rem;
      color: var(--text-muted);
    }

    /* خط التوهج */
    .divider-glow {
      height: 1px;
      background: linear-gradient(90deg, transparent, var(--purple-glow), transparent);
      opacity: 0.4;
      margin: 0 auto 2.5rem;
      max-width: 400px;
    }

    @keyframes pulse-dot {
      0%, 100% { opacity: 1; }
      50% { opacity: 0.4; }
    }
    .pulse-dot { animation: pulse-dot 2s ease-in-out infinite; }

    /* تقسيم بطاقات السيرفرات */
    .servers-grid {
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }

    /* شريط المعلومات العلوي */
    .info-bar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 1rem;
      margin-bottom: 1.5rem;
    }

    .servers-count {
      font-size: 0.9rem;
      color: var(--text-muted);
    }
    .servers-count span {
      color: #a855f7;
      font-weight: 700;
    }
  </style>
</head>
<body>

<!-- خلفية النجوم -->
<div class="stars-bg"></div>

<!-- ===== النافبار ===== -->
<nav class="navbar">
  <a href="/" style="text-decoration:none;" class="navbar-logo">🎫 DARK TICKET</a>
  <div style="display:flex; align-items:center; gap:0.75rem;">
    <div class="user-info">
      <% if (user.avatar) { %>
        <img
          class="user-avatar"
          src="https://cdn.discordapp.com/avatars/<%= user.id %>/<%= user.avatar %>.png?size=64"
          alt="Avatar"
        />
      <% } else { %>
        <div style="width:32px;height:32px;border-radius:50%;background:linear-gradient(135deg,#6d28d9,#8a2be2);display:flex;align-items:center;justify-content:center;font-size:0.85rem;font-weight:700;color:#fff;border:2px solid var(--purple-glow);">
          <%= user.username.charAt(0).toUpperCase() %>
        </div>
      <% } %>
      <span class="user-name"><%= user.username %></span>
    </div>
    <a href="/auth/logout" class="btn-logout">تسجيل الخروج</a>
  </div>
</nav>

<!-- ===== المحتوى الرئيسي ===== -->
<main style="position:relative; z-index:1; padding: 6.5rem 2rem 4rem; max-width: 820px; margin: 0 auto;">

  <!-- العنوان -->
  <div style="text-align:center; margin-bottom:2.5rem;">
    <div class="divider-glow"></div>
    <h1 style="font-size:2rem; font-weight:900; margin-bottom:0.6rem;">
      اختر <span class="text-glow">سيرفرك</span>
    </h1>
    <p style="color:var(--text-muted); font-size:0.97rem; line-height:1.8;">
      تظهر هنا فقط السيرفرات التي تمتلك فيها صلاحية <strong style="color:#a855f7;">إدارة السيرفر</strong>، وتواجد البوت فيها.
    </p>
  </div>

  <!-- شريط معلومات -->
  <div class="info-bar">
    <div class="servers-count">
      إجمالي السيرفرات المتاحة:
      <span><%= guilds.length %></span>
    </div>
    <!-- زر دعوة البوت -->
    <a
      href="https://discord.com/api/oauth2/authorize?client_id=<%= clientId %>&permissions=8&scope=bot%20applications.commands"
      target="_blank"
      rel="noopener"
      class="btn-invite"
    >
      ➕ أضف البوت لسيرفر جديد
    </a>
  </div>

  <!-- قائمة السيرفرات -->
  <% if (guilds.length === 0) { %>
    <!-- حالة الفراغ -->
    <div class="glass-card empty-state">
      <div style="font-size:3.5rem; margin-bottom:1rem;">🔍</div>
      <h3 style="font-size:1.2rem; font-weight:700; color:#e2d9f3; margin-bottom:0.5rem;">
        لا توجد سيرفرات متاحة
      </h3>
      <p style="font-size:0.95rem; line-height:1.8; max-width:400px; margin:0 auto 1.5rem;">
        لم نجد أي سيرفر لديك فيه صلاحية الإدارة وتواجد البوت في نفس الوقت.
        أضف البوت لأحد سيرفراتك أولاً.
      </p>
      <a
        href="https://discord.com/api/oauth2/authorize?client_id=<%= clientId %>&permissions=8&scope=bot%20applications.commands"
        target="_blank"
        rel="noopener"
        class="btn-setup"
        style="margin: 0 auto;"
      >
        ➕ دعوة البوت الآن
      </a>
    </div>

  <% } else { %>
    <div class="servers-grid">
      <% guilds.forEach(function(guild) { %>
        <div class="server-card">

          <!-- أيقونة السيرفر -->
          <% if (guild.icon) { %>
            <img
              class="server-icon"
              src="https://cdn.discordapp.com/icons/<%= guild.id %>/<%= guild.icon %>.png?size=128"
              alt="<%= guild.name %>"
            />
          <% } else { %>
            <div class="server-icon-placeholder">
              <%= guild.name.charAt(0).toUpperCase() %>
            </div>
          <% } %>

          <!-- معلومات السيرفر -->
          <div style="flex:1; min-width:0;">
            <div style="display:flex; align-items:center; gap:0.65rem; flex-wrap:wrap; margin-bottom:0.35rem;">
              <h3 style="font-size:1.05rem; font-weight:700; color:#e2d9f3; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; max-width:280px;">
                <%= guild.name %>
              </h3>
              <% if (guild.botPresent) { %>
                <span class="badge-active">
                  <span class="pulse-dot" style="width:6px;height:6px;border-radius:50%;background:#4ade80;display:inline-block;"></span>
                  البوت نشط
                </span>
              <% } else { %>
                <span class="badge-inactive">
                  <span style="width:6px;height:6px;border-radius:50%;background:var(--text-muted);display:inline-block;"></span>
                  البوت غير موجود
                </span>
              <% } %>
            </div>
            <div style="font-size:0.82rem; color:var(--text-muted);">
              ID: <%= guild.id %>
            </div>
          </div>

          <!-- زر الإجراء -->
          <% if (guild.botPresent) { %>
            <a href="/manage/<%= guild.id %>" class="btn-setup">
              🎛️ إعداد التذاكر
            </a>
          <% } else { %>
            <a
              href="https://discord.com/api/oauth2/authorize?client_id=<%= clientId %>&permissions=8&scope=bot%20applications.commands&guild_id=<%= guild.id %>"
              target="_blank"
              rel="noopener"
              class="btn-invite"
            >
              ➕ أضف البوت
            </a>
          <% } %>

        </div>
      <% }); %>
    </div>
  <% } %>

</main>

<!-- ===== الفوتر ===== -->
<footer style="position:relative;z-index:1;border-top:1px solid var(--border-glass);padding:1.5rem;text-align:center;color:var(--text-muted);font-size:0.85rem;margin-top:2rem;">
  <span class="text-glow" style="font-weight:700;">🎫 DARK TICKET</span>
  &nbsp;—&nbsp; جميع الحقوق محفوظة © <%= new Date().getFullYear() %>
</footer>

</body>
</html>

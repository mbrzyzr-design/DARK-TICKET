<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>DARK TICKET — نظام التذاكر الاحترافي</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;900&display=swap" rel="stylesheet" />
  <style>
    /* ===== المتغيرات والإعدادات الأساسية ===== */
    :root {
      --bg-primary:   #0b0b12;
      --bg-panel:     rgba(20, 20, 35, 0.75);
      --purple-glow:  #8a2be2;
      --purple-light: #a855f7;
      --purple-dim:   rgba(138, 43, 226, 0.15);
      --border-glass: rgba(138, 43, 226, 0.25);
      --text-primary: #f0e6ff;
      --text-muted:   #8b85a0;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: 'Cairo', sans-serif;
      background-color: var(--bg-primary);
      color: var(--text-primary);
      overflow-x: hidden;
      min-height: 100vh;
    }

    /* ===== خلفية النجوم المتحركة ===== */
    .stars-bg {
      position: fixed;
      inset: 0;
      background:
        radial-gradient(ellipse at 20% 20%, rgba(138,43,226,0.12) 0%, transparent 60%),
        radial-gradient(ellipse at 80% 80%, rgba(88,28,135,0.10) 0%, transparent 60%),
        var(--bg-primary);
      z-index: 0;
    }

    .stars-bg::before {
      content: '';
      position: absolute;
      inset: 0;
      background-image:
        radial-gradient(1px 1px at 10% 15%, rgba(255,255,255,0.6) 0%, transparent 100%),
        radial-gradient(1px 1px at 30% 40%, rgba(255,255,255,0.4) 0%, transparent 100%),
        radial-gradient(1px 1px at 50% 10%, rgba(255,255,255,0.5) 0%, transparent 100%),
        radial-gradient(1px 1px at 70% 60%, rgba(255,255,255,0.3) 0%, transparent 100%),
        radial-gradient(1px 1px at 90% 30%, rgba(255,255,255,0.6) 0%, transparent 100%),
        radial-gradient(1px 1px at 15% 75%, rgba(255,255,255,0.4) 0%, transparent 100%),
        radial-gradient(1px 1px at 55% 85%, rgba(255,255,255,0.5) 0%, transparent 100%),
        radial-gradient(1px 1px at 85% 90%, rgba(255,255,255,0.3) 0%, transparent 100%),
        radial-gradient(2px 2px at 40% 55%, rgba(168,85,247,0.7) 0%, transparent 100%),
        radial-gradient(2px 2px at 75% 20%, rgba(168,85,247,0.5) 0%, transparent 100%);
    }

    /* ===== بطاقات الزجاج (Glassmorphism) ===== */
    .glass-card {
      background: var(--bg-panel);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border: 1px solid var(--border-glass);
      border-radius: 1.25rem;
      box-shadow:
        0 0 30px rgba(138,43,226,0.08),
        inset 0 1px 0 rgba(255,255,255,0.05);
      transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

    .glass-card:hover {
      transform: translateY(-4px);
      box-shadow:
        0 0 50px rgba(138,43,226,0.2),
        inset 0 1px 0 rgba(255,255,255,0.08);
    }

    /* ===== زر تسجيل الدخول المتوهج ===== */
    .btn-glow {
      position: relative;
      display: inline-flex;
      align-items: center;
      gap: 0.6rem;
      padding: 0.9rem 2.4rem;
      background: linear-gradient(135deg, #6d28d9, #8a2be2, #7c3aed);
      color: #fff;
      font-family: 'Cairo', sans-serif;
      font-size: 1.1rem;
      font-weight: 700;
      border: none;
      border-radius: 0.75rem;
      cursor: pointer;
      text-decoration: none;
      overflow: hidden;
      transition: all 0.3s ease;
      box-shadow:
        0 0 20px rgba(138,43,226,0.5),
        0 0 60px rgba(138,43,226,0.2),
        inset 0 1px 0 rgba(255,255,255,0.15);
    }

    .btn-glow::before {
      content: '';
      position: absolute;
      top: 0; left: -100%;
      width: 100%; height: 100%;
      background: linear-gradient(90deg, transparent, rgba(255,255,255,0.15), transparent);
      transition: left 0.5s ease;
    }

    .btn-glow:hover::before { left: 100%; }

    .btn-glow:hover {
      transform: translateY(-2px) scale(1.02);
      box-shadow:
        0 0 35px rgba(138,43,226,0.75),
        0 0 80px rgba(138,43,226,0.35),
        inset 0 1px 0 rgba(255,255,255,0.2);
    }

    .btn-glow:active { transform: translateY(0) scale(0.99); }

    /* ===== نص متوهج ===== */
    .text-glow {
      background: linear-gradient(135deg, #c084fc, #a855f7, #8a2be2);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      filter: drop-shadow(0 0 20px rgba(168,85,247,0.4));
    }

    /* ===== النافبار ===== */
    .navbar {
      position: fixed;
      top: 0; left: 0; right: 0;
      z-index: 100;
      padding: 1rem 2rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      background: rgba(11,11,18,0.85);
      backdrop-filter: blur(20px);
      border-bottom: 1px solid var(--border-glass);
    }

    .navbar-logo {
      font-size: 1.4rem;
      font-weight: 900;
      letter-spacing: 1px;
    }

    /* ===== إحصائيات ===== */
    .stat-number {
      font-size: 2.8rem;
      font-weight: 900;
      line-height: 1;
    }

    /* ===== خط التوهج الأفقي ===== */
    .divider-glow {
      height: 1px;
      background: linear-gradient(90deg, transparent, var(--purple-glow), transparent);
      opacity: 0.5;
      margin: 0 auto;
      max-width: 600px;
    }

    /* ===== أيقونات الميزات ===== */
    .feature-icon {
      width: 3.5rem;
      height: 3.5rem;
      border-radius: 0.875rem;
      background: var(--purple-dim);
      border: 1px solid var(--border-glass);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.6rem;
      flex-shrink: 0;
    }

    /* ===== خلفية البطل ===== */
    .hero-glow {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      width: 600px;
      height: 600px;
      background: radial-gradient(circle, rgba(138,43,226,0.18) 0%, transparent 70%);
      pointer-events: none;
    }

    /* ===== تأثير النبض ===== */
    @keyframes pulse-glow {
      0%, 100% { opacity: 0.7; }
      50% { opacity: 1; }
    }

    .pulse { animation: pulse-glow 3s ease-in-out infinite; }

    /* ===== الفوتر ===== */
    footer {
      border-top: 1px solid var(--border-glass);
      padding: 2rem;
      text-align: center;
      color: var(--text-muted);
      font-size: 0.9rem;
    }
  </style>
</head>
<body>

<!-- خلفية النجوم -->
<div class="stars-bg"></div>

<!-- ===== النافبار ===== -->
<nav class="navbar">
  <div class="navbar-logo text-glow">🎫 DARK TICKET</div>
  <a href="/auth/login" class="btn-glow" style="padding: 0.6rem 1.5rem; font-size: 0.95rem;">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
      <path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057c.002.022.015.04.032.05a19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028c.462-.63.874-1.295 1.226-1.994a.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03z"/>
    </svg>
    دخول
  </a>
</nav>

<!-- ===== قسم البطل الرئيسي ===== -->
<section style="position: relative; z-index: 1; min-height: 100vh; display: flex; align-items: center; justify-content: center; padding: 8rem 2rem 4rem;">
  <div class="hero-glow pulse"></div>
  <div style="text-align: center; max-width: 750px; position: relative;">

    <!-- شارة جديد -->
    <div style="display: inline-flex; align-items: center; gap: 0.5rem; background: var(--purple-dim); border: 1px solid var(--border-glass); border-radius: 100px; padding: 0.35rem 1rem; margin-bottom: 2rem; font-size: 0.85rem; color: #c084fc;">
      <span style="width:6px;height:6px;border-radius:50%;background:#a855f7;display:inline-block;" class="pulse"></span>
      الآن متاح للجميع — جرّبه مجاناً
    </div>

    <!-- العنوان الرئيسي -->
    <h1 style="font-size: clamp(2.5rem, 6vw, 4.5rem); font-weight: 900; line-height: 1.15; margin-bottom: 1.5rem; color: #f0e6ff;">
      أفضل نظام تذاكر<br/>
      <span class="text-glow">لسيرفرات ديسكورد</span>
    </h1>

    <!-- الوصف -->
    <p style="font-size: 1.15rem; color: var(--text-muted); max-width: 560px; margin: 0 auto 2.5rem; line-height: 1.9;">
      DARK TICKET يمنحك نظام دعم فني متكامل وأنيق لسيرفرك. فتح وإغلاق التذاكر بضغطة زر، لوحة تحكم ويب عربية شاملة، وتجربة لا مثيل لها.
    </p>

    <!-- أزرار الدخول -->
    <div style="display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap;">
      <a href="/auth/login" class="btn-glow" style="font-size: 1.15rem; padding: 1rem 2.8rem;">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor">
          <path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057c.002.022.015.04.032.05a19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028c.462-.63.874-1.295 1.226-1.994a.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03z"/>
        </svg>
        تسجيل الدخول عبر ديسكورد
      </a>
      <a href="#features" style="display: inline-flex; align-items: center; gap: 0.5rem; padding: 1rem 2rem; border: 1px solid var(--border-glass); border-radius: 0.75rem; color: var(--text-muted); font-family: 'Cairo', sans-serif; font-size: 1rem; font-weight: 600; text-decoration: none; background: var(--bg-panel); backdrop-filter: blur(10px); transition: all 0.3s ease;">
        استعرض المميزات ↓
      </a>
    </div>

    <!-- إحصائيات سريعة -->
    <div style="display: flex; justify-content: center; gap: 3rem; margin-top: 4rem; flex-wrap: wrap;">
      <div style="text-align: center;">
        <div class="stat-number text-glow">+12K</div>
        <div style="color: var(--text-muted); font-size: 0.9rem; margin-top: 0.25rem;">سيرفر نشط</div>
      </div>
      <div style="width: 1px; background: var(--border-glass);"></div>
      <div style="text-align: center;">
        <div class="stat-number text-glow">+80K</div>
        <div style="color: var(--text-muted); font-size: 0.9rem; margin-top: 0.25rem;">تذكرة محلولة</div>
      </div>
      <div style="width: 1px; background: var(--border-glass);"></div>
      <div style="text-align: center;">
        <div class="stat-number text-glow">99.9%</div>
        <div style="color: var(--text-muted); font-size: 0.9rem; margin-top: 0.25rem;">وقت التشغيل</div>
      </div>
    </div>
  </div>
</section>

<!-- ===== قسم المميزات ===== -->
<section id="features" style="position: relative; z-index: 1; padding: 4rem 2rem 6rem;">
  <div style="max-width: 1100px; margin: 0 auto;">

    <div style="text-align: center; margin-bottom: 3.5rem;">
      <div class="divider-glow" style="margin-bottom: 2rem;"></div>
      <h2 style="font-size: 2.2rem; font-weight: 900; margin-bottom: 0.75rem;">
        لماذا <span class="text-glow">DARK TICKET</span>؟
      </h2>
      <p style="color: var(--text-muted); font-size: 1rem; max-width: 500px; margin: 0 auto;">
        كل ما تحتاجه لإدارة دعم فني احترافي في سيرفرك.
      </p>
    </div>

    <!-- شبكة الميزات -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 1.5rem;">

      <!-- ميزة 1 -->
      <div class="glass-card" style="padding: 2rem; display: flex; gap: 1.25rem; align-items: flex-start;">
        <div class="feature-icon">🔐</div>
        <div>
          <h3 style="font-size: 1.1rem; font-weight: 700; margin-bottom: 0.5rem; color: #e2d9f3;">دخول آمن بـ OAuth2</h3>
          <p style="color: var(--text-muted); font-size: 0.92rem; line-height: 1.7;">تسجيل الدخول عبر ديسكورد رسمياً. لا كلمات مرور، لا مخاطر. فقط الحسابات ذات الصلاحية تستطيع التعديل.</p>
        </div>
      </div>

      <!-- ميزة 2 -->
      <div class="glass-card" style="padding: 2rem; display: flex; gap: 1.25rem; align-items: flex-start;">
        <div class="feature-icon">🎛️</div>
        <div>
          <h3 style="font-size: 1.1rem; font-weight: 700; margin-bottom: 0.5rem; color: #e2d9f3;">لوحة تحكم عربية</h3>
          <p style="color: var(--text-muted); font-size: 0.92rem; line-height: 1.7;">أول لوحة تحكم لبوت ديسكورد بالكامل باللغة العربية. سهلة، واضحة، وتتحكم بكل شيء من مكان واحد.</p>
        </div>
      </div>

      <!-- ميزة 3 -->
      <div class="glass-card" style="padding: 2rem; display: flex; gap: 1.25rem; align-items: flex-start;">
        <div class="feature-icon">🎨</div>
        <div>
          <h3 style="font-size: 1.1rem; font-weight: 700; margin-bottom: 0.5rem; color: #e2d9f3;">بانل مخصص بالكامل</h3>
          <p style="color: var(--text-muted); font-size: 0.92rem; line-height: 1.7;">خصّص عنوان ووصف ولون رسالة البانل لتناسب هوية سيرفرك، وأرسله للروم المناسب بضغطة واحدة.</p>
        </div>
      </div>

      <!-- ميزة 4 -->
      <div class="glass-card" style="padding: 2rem; display: flex; gap: 1.25rem; align-items: flex-start;">
        <div class="feature-icon">🔒</div>
        <div>
          <h3 style="font-size: 1.1rem; font-weight: 700; margin-bottom: 0.5rem; color: #e2d9f3;">تذاكر خاصة ومحمية</h3>
          <p style="color: var(--text-muted); font-size: 0.92rem; line-height: 1.7;">كل تذكرة روم خاص لا يراه غير صاحب التذكرة وفريق الدعم. حماية كاملة للخصوصية.</p>
        </div>
      </div>

      <!-- ميزة 5 -->
      <div class="glass-card" style="padding: 2rem; display: flex; gap: 1.25rem; align-items: flex-start;">
        <div class="feature-icon">⚡</div>
        <div>
          <h3 style="font-size: 1.1rem; font-weight: 700; margin-bottom: 0.5rem; color: #e2d9f3;">أزرار تفاعلية فورية</h3>
          <p style="color: var(--text-muted); font-size: 0.92rem; line-height: 1.7;">لا أوامر مكتوبة، لا تعقيد. فتح التذكرة وإغلاقها بزر واحد. سريع وعملي لكل الأعضاء.</p>
        </div>
      </div>

      <!-- ميزة 6 -->
      <div class="glass-card" style="padding: 2rem; display: flex; gap: 1.25rem; align-items: flex-start;">
        <div class="feature-icon">💾</div>
        <div>
          <h3 style="font-size: 1.1rem; font-weight: 700; margin-bottom: 0.5rem; color: #e2d9f3;">إعدادات دائمة</h3>
          <p style="color: var(--text-muted); font-size: 0.92rem; line-height: 1.7;">إعداداتك تُحفظ في قاعدة بيانات MongoDB. لا تعود لإعداد البوت بعد كل إعادة تشغيل.</p>
        </div>
      </div>

    </div>
  </div>
</section>

<!-- ===== قسم CTA ===== -->
<section style="position: relative; z-index: 1; padding: 3rem 2rem 6rem;">
  <div style="max-width: 700px; margin: 0 auto; text-align: center;">
    <div class="glass-card" style="padding: 3.5rem 2rem;">
      <h2 style="font-size: 2rem; font-weight: 900; margin-bottom: 1rem;">
        ابدأ الآن <span class="text-glow">مجاناً</span>
      </h2>
      <p style="color: var(--text-muted); font-size: 1rem; margin-bottom: 2rem; line-height: 1.8;">
        أضف البوت لسيرفرك، سجّل دخولك، وأعدّ نظام التذاكر في أقل من دقيقتين.
      </p>
      <a href="/auth/login" class="btn-glow" style="font-size: 1.1rem; padding: 1rem 2.5rem;">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor">
          <path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057c.002.022.015.04.032.05a19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028c.462-.63.874-1.295 1.226-1.994a.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03z"/>
        </svg>
        ابدأ الإعداد الآن
      </a>
    </div>
  </div>
</section>

<!-- ===== الفوتر ===== -->
<footer>
  <div style="margin-bottom: 0.5rem;">
    <span class="text-glow" style="font-weight: 700; font-size: 1.1rem;">🎫 DARK TICKET</span>
  </div>
  <p>صُنع بـ ❤️ — جميع الحقوق محفوظة © <%= new Date().getFullYear() %></p>
</footer>

</body>
</html>
